    "type": "drupal-recipe",
    "version": "1.0.0-alpha1",
    "keywords": [
        "recipe",
        "Varbase recipes",
        "Drupal recipes",
        "Varbase AI",
        "MCP",
        "Model Context Protocol",
        "OAuth 2.1",
        "Tool API"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/varbase_ai_mcp_server_base",
    "authors": [
        {
            "name": "Vardot",
            "homepage": "https://www.vardot.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/varbase_ai_mcp_server_base",
        "source": "https://git.drupalcode.org/project/varbase_ai_mcp_server_base"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "drupal/consumers": "^1.24",
        "drupal/core": "^11.4",
        "drupal/mcp": "2.0.x-dev",
        "drupal/mcp_server": "^2.0@beta",
        "drupal/mcp_server_oauth": "^1.0@alpha",
        "drupal/mcp_server_tool_bridge": "^1.0@beta",
        "drupal/simple_oauth": "^6.1",
        "drupal/tool": "^1.0@beta",
        "drupal/tool_belt": "^1.0@alpha",
        "e0ipso/simple_oauth_21": "^1.13"
    }
